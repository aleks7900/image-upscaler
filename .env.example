# ==============================================================================
# CUDA Batch Image Upscaler for Adobe Stock — Configuration Environment
# ==============================================================================

# Database
POSTGRES_DB=image_upscaler
POSTGRES_USER=upscaler
POSTGRES_PASSWORD=upscaler_secret_pass
POSTGRES_PORT=5432

# Storage
STORAGE_ROOT=/data

# GPU Worker Inference & Tiling
GPU_WORKER_URL=http://gpu-worker:8000
GPU_CONCURRENCY=1
GPU_TILE_SIZE=512
GPU_TILE_PADDING=32
GPU_MAX_RETRIES=3
MODEL_CACHE_DIR=/cache

# Super-Resolution Defaults
UPSCALE_DEFAULT_MODEL=general
UPSCALE_DEFAULT_SCALE=4
MAX_BATCH_IMAGES=1000
MAX_FILE_SIZE_MB=100

# Adobe Stock Compliance Parameters
ADOBE_STOCK_MIN_MP=4.0
ADOBE_STOCK_MAX_MP=100.0
ADOBE_STOCK_MAX_FILE_MB=45
ADOBE_STOCK_JPEG_QUALITY=95
ADOBE_STOCK_MIN_JPEG_QUALITY=85

# Ports
FRONTEND_PORT=80
BACKEND_PORT=8080
